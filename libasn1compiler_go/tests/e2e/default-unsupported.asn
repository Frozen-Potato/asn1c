Default-Unsupported DEFINITIONS AUTOMATIC TAGS ::=
BEGIN

-- A DEFAULT the C generator gives no default callbacks for (a CHOICE value
-- inside a SEQUENCE value) is refused by the Go backend before the C pass
-- runs.

Choice ::= CHOICE {
    n   INTEGER (0..255),
    b   BOOLEAN
}

Point ::= SEQUENCE {
    c   Choice
}

Holder ::= SEQUENCE {
    n   INTEGER (0..7),
    p   Point DEFAULT { c n : 3 }
}

END
