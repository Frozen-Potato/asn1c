Probe DEFINITIONS AUTOMATIC TAGS ::= BEGIN

-- A NULL written directly in an object: its alternative has no payload (the
-- C union member is NULL_, NULL being a C macro).
Id ::= INTEGER (0..255)
CLS ::= CLASS { &id Id UNIQUE, &Value } WITH SYNTAX { ID &id TYPE &Value }
IntVal ::= INTEGER (0..255)
Objs CLS ::= { { ID 1 TYPE IntVal } | { ID 2 TYPE NULL }, ... }
IE ::= SEQUENCE { id CLS.&id ({Objs}), value CLS.&Value ({Objs}{@id}) }

END
