SofPrintableAlt ::= CHOICE { a SEQUENCE (SIZE(1..4)) OF PrintableString, b BOOLEAN }

-- sof-printable-top
SofPrintableTop ::= SEQUENCE (SIZE(1..4)) OF PrintableString

-- sof-real-mem
SofRealMem ::= SEQUENCE { a SEQUENCE (SIZE(1..4)) OF REAL, b BOOLEAN }

-- sof-real-top
SofRealTop ::= SEQUENCE (SIZE(1..4)) OF REAL

-- sof-roid-mem
SofRoidMem ::= SEQUENCE { a SEQUENCE OF RELATIVE-OID, b BOOLEAN }

-- sof-roid-top
SofRoidTop ::= SEQUENCE OF RELATIVE-OID

