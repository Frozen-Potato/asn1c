SofSeqAlt ::= CHOICE { a SEQUENCE (SIZE(1..4)) OF SEQUENCE { x INTEGER (0..3) }, b BOOLEAN }

-- sof-seq-mem
SofSeqMem ::= SEQUENCE { a SEQUENCE (SIZE(1..4)) OF SEQUENCE { x INTEGER (0..3), y BOOLEAN }, b BOOLEAN }

