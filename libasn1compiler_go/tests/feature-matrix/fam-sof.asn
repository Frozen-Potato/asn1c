SofSofSeqTop ::= SEQUENCE (SIZE(1..3)) OF SEQUENCE OF SEQUENCE { a INTEGER (0..3) }

-- sof-sof-size-both
SofSofSizeBoth ::= SEQUENCE (SIZE(1..3)) OF SEQUENCE (SIZE(1..3)) OF INTEGER (0..3)

-- sof-sof-top
