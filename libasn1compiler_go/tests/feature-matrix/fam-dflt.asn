Probe DEFINITIONS AUTOMATIC TAGS ::= BEGIN
IMPORTS DfltNoPduBox FROM DfltNoPdu;

-- dflt-enum-ok
DfltEnumOk ::= SEQUENCE { a ENUMERATED { x, y } DEFAULT y, b BOOLEAN }

-- dflt-ia5
DfltIa5 ::= SEQUENCE { a IA5String DEFAULT "hi", b BOOLEAN }

-- dflt-bmp
DfltBmp ::= SEQUENCE { a BMPString DEFAULT "hi", b BOOLEAN }

-- dflt-universal
DfltUniversal ::= SEQUENCE { a UniversalString DEFAULT "hi", b BOOLEAN }

-- dflt-utf8
DfltUtf8 ::= SEQUENCE { a UTF8String DEFAULT "é€", b BOOLEAN }

-- dflt-utctime
DfltUtctime ::= SEQUENCE { a UTCTime DEFAULT "250102030405Z", b BOOLEAN }

-- dflt-gentime
DfltGentime ::= SEQUENCE { a GeneralizedTime DEFAULT "20250102030405Z", b BOOLEAN }

-- dflt-other-str
DfltOtherStr ::= SEQUENCE {
    gen GeneralString DEFAULT "g", gra GraphicString DEFAULT "g",
    tel TeletexString DEFAULT "g", t61 T61String DEFAULT "g",
    vid VideotexString DEFAULT "g", od ObjectDescriptor DEFAULT "g", b BOOLEAN }

-- dflt-null
DfltNull ::= SEQUENCE { a NULL DEFAULT NULL, b BOOLEAN }

-- dflt-real
DfltReal ::= SEQUENCE { a REAL DEFAULT 1.5, b BOOLEAN }

-- dflt-real-forms
DfltRealForms ::= SEQUENCE {
    z REAL DEFAULT 0, m REAL DEFAULT -2.25, i REAL DEFAULT 2, e REAL DEFAULT 1e3,
    p REAL DEFAULT PLUS-INFINITY, q REAL DEFAULT MINUS-INFINITY,
    n REAL DEFAULT NOT-A-NUMBER, nz REAL DEFAULT -0.0, b BOOLEAN }

-- dflt-real-float
DfltRealFloat ::= SEQUENCE {
    a REAL (WITH COMPONENTS { mantissa (-16777215..16777215), base (2),
        exponent (-100..100) }) DEFAULT 0.1,
    p REAL (WITH COMPONENTS { mantissa (-16777215..16777215), base (2),
        exponent (-100..100) }) DEFAULT PLUS-INFINITY,
    b BOOLEAN }

-- dflt-namedbit
DfltNamedBit ::= SEQUENCE { a BIT STRING { p(0), q(1) } DEFAULT { p }, b BOOLEAN }

-- dflt-namedbit-forms
NbPerms ::= BIT STRING { read(0), write(1) } (SIZE (8))
DfltNamedBitForms ::= SEQUENCE {
    e BIT STRING { p(0), q(1) } DEFAULT { },
    f BIT STRING { p(0), q(1) } DEFAULT { p, q },
    g NbPerms DEFAULT { read },
    h BIT STRING { p(0), q(1) } DEFAULT '01'B, b BOOLEAN }

-- dflt-oid
DfltOid ::= SEQUENCE { a OBJECT IDENTIFIER DEFAULT { 1 3 6 }, b BOOLEAN }

-- dflt-oid-forms
DfltOidForms ::= SEQUENCE {
    a OBJECT IDENTIFIER DEFAULT { iso(1) org(3) 6 1 },
    c OBJECT IDENTIFIER DEFAULT { joint-iso-itu-t 5 },
    d OBJECT IDENTIFIER DEFAULT { 2 999 4294967295 }, b BOOLEAN }

-- dflt-roid
DfltRoid ::= SEQUENCE { a RELATIVE-OID DEFAULT { 1 2 }, b BOOLEAN }

-- dflt-oid-ref
dflt-oid-ref-base OBJECT IDENTIFIER ::= { 1 3 6 1 }
dflt-oid-ref-rel RELATIVE-OID ::= { 8 9 }
DfltOidRef ::= SEQUENCE {
    a OBJECT IDENTIFIER DEFAULT dflt-oid-ref-base,
    c OBJECT IDENTIFIER DEFAULT { dflt-oid-ref-base 5 },
    d OBJECT IDENTIFIER DEFAULT { dflt-oid-ref-base dflt-oid-ref-rel },
    r RELATIVE-OID DEFAULT { dflt-oid-ref-rel 1 }, b BOOLEAN }

-- dflt-seq
DfltSeqPt ::= SEQUENCE { x INTEGER (0..7), y INTEGER (0..7) DEFAULT 3 }
dflt-seq-pt0 DfltSeqPt ::= { x 1, y 2 }
DfltSeq ::= SEQUENCE {
    a DfltSeqPt DEFAULT { x 1, y 2 },
    b DfltSeqPt DEFAULT dflt-seq-pt0,
    c SEQUENCE { m INTEGER (0..9) } DEFAULT { m 5 },
    z BOOLEAN }

-- dflt-seqof
DfltSeqofLs ::= SEQUENCE (SIZE (0..4)) OF INTEGER (0..9)
DfltSeqofPt ::= SEQUENCE { x INTEGER (0..7) }
DfltSeqof ::= SEQUENCE {
    a DfltSeqofLs DEFAULT { },
    b DfltSeqofLs DEFAULT { 1, 2 },
    c SEQUENCE (SIZE (0..3)) OF DfltSeqofPt DEFAULT { { x 1 }, { x 2 } },
    d SET (SIZE (0..3)) OF BOOLEAN DEFAULT { TRUE },
    z BOOLEAN }

-- dflt-set
DfltSetSt ::= SET { p INTEGER (0..9), q BOOLEAN, r IA5String DEFAULT "ab" }
DfltSet ::= SEQUENCE {
    a DfltSetSt DEFAULT { r "x", q TRUE, p 3 },
    b SET { u INTEGER (0..3), v BOOLEAN } DEFAULT { v TRUE, u 1 },
    z BOOLEAN }

-- dflt-nested
DfltNestedPt ::= SEQUENCE { x INTEGER (0..7), y INTEGER (0..7) DEFAULT 3 }
DfltNestedLs ::= SEQUENCE OF INTEGER (0..9)
DfltNested ::= SEQUENCE {
    a SEQUENCE { n SEQUENCE { v DfltNestedLs, w INTEGER (0..9) } }
        DEFAULT { n { v { 3, 4 }, w 9 } },
    b SEQUENCE {
        inner DfltNestedPt DEFAULT { x 3 },
        k BOOLEAN } OPTIONAL,
    c SEQUENCE { d SEQUENCE { e DfltNestedPt DEFAULT { x 1 }, f BOOLEAN } },
    z BOOLEAN }

-- dflt-choice
DfltChoicePt ::= SEQUENCE { x INTEGER (0..7), y INTEGER (0..7) DEFAULT 3 }
DfltChoice ::= CHOICE {
    s SEQUENCE { q DfltChoicePt DEFAULT { x 2 } },
    t SEQUENCE { m SEQUENCE { r DfltChoicePt DEFAULT { x 4 }, k BOOLEAN }, j BOOLEAN },
    o INTEGER (0..9) }
DfltChoiceIn ::= SEQUENCE {
    c CHOICE { s SEQUENCE { q DfltChoicePt DEFAULT { x 3 } }, o INTEGER (0..9) } }

-- dflt-nopdu-use
DfltNoPduUse ::= SEQUENCE { b DfltNoPduBox, n INTEGER (0..9) }

END

-- dflt-nopdu: the owner lives in a module without a PDU
DfltNoPdu DEFINITIONS AUTOMATIC TAGS ::= BEGIN
EXPORTS ALL;
DfltNoPduPt ::= SEQUENCE { x INTEGER (0..7), y INTEGER (0..7) DEFAULT 3 }
DfltNoPduBox ::= SEQUENCE { p DfltNoPduPt DEFAULT { x 1 }, k INTEGER (0..3) }
END
