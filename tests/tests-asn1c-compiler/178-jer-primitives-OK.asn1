ModuleJERPrimitives
    { iso org(3) dod(6) internet(1) private(4) enterprise(1)
        spelio(9363) software(1) asn1c(5) test(1) 178 }
DEFINITIONS AUTOMATIC TAGS ::= BEGIN
B12 ::= BIT STRING (SIZE(12))
BV ::= BIT STRING (SIZE(1..16))
BX ::= BIT STRING (SIZE(8,...))
BN ::= BIT STRING { a(0), b(3) }
O2 ::= OCTET STRING (SIZE(2))
I ::= INTEGER (0..255)
E ::= ENUMERATED { red, green, ... }
Fx ::= SEQUENCE { f BIT STRING (SIZE(12)) }
END
