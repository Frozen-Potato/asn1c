-- OK: PER encoding of known-multiplier character strings (X.691 #30.4,
-- #30.5): bits per character from the effective alphabet (rounded up to a
-- power of 2 in APER), index vs. raw character values, octet alignment of
-- short fixed-size (#30.5.6) and variable-size (#30.5.7) strings, the
-- alphabet kept for a size outside an extensible root, bare string
-- members, and aliases (N2 ::= N) of string types.

K181 DEFINITIONS AUTOMATIC TAGS ::= BEGIN

S1 ::= SEQUENCE { f BOOLEAN, s NumericString (SIZE(4)) }
S2 ::= SEQUENCE { f BOOLEAN, s NumericString (SIZE(5)) }
S3 ::= SEQUENCE { f BOOLEAN, s NumericString (SIZE(1..3)) }
S4 ::= SEQUENCE { f BOOLEAN, s NumericString (SIZE(1..10)) }
S5 ::= SEQUENCE { f BOOLEAN, s NumericString }
S6 ::= SEQUENCE { f BOOLEAN, s IA5String (FROM("AB") ^ SIZE(1..8)) }
S7 ::= SEQUENCE { f BOOLEAN, s IA5String (FROM("ABCDEFGHIJ")) (SIZE(3)) }
S8 ::= SEQUENCE { f BOOLEAN, s PrintableString (FROM("0".."9"|"A".."F")) (SIZE(8)) }
S9 ::= SEQUENCE { f BOOLEAN, s NumericString (SIZE(2)) }
S10 ::= SEQUENCE { f BOOLEAN, s NumericString (SIZE(1..4, ...)) }
S11 ::= SEQUENCE { f BOOLEAN, s VisibleString (FROM("a".."z")) (SIZE(1..8)) }
S12 ::= SEQUENCE { f BOOLEAN, s IA5String (FROM("0".."7")) (SIZE(0..2)) }
T1 ::= SEQUENCE { f BOOLEAN, s IA5String (SIZE(1)) }
T2 ::= SEQUENCE { f BOOLEAN, s IA5String (SIZE(2)) }
T3 ::= SEQUENCE { f BOOLEAN, s PrintableString (SIZE(2)) }
T4 ::= SEQUENCE { f BOOLEAN, s VisibleString (SIZE(3)) }
T5 ::= SEQUENCE { f BOOLEAN, s IA5String (SIZE(1..2)) }
T6 ::= SEQUENCE { f BOOLEAN, s PrintableString (FROM("0".."9"|"A".."F")) (SIZE(1..8)) }
T7 ::= SEQUENCE { f BOOLEAN, s OCTET STRING (SIZE(2)) }
T8 ::= SEQUENCE { f BOOLEAN, s BMPString (SIZE(1)) }
U1 ::= SEQUENCE { f BOOLEAN, s BMPString (FROM("A".."Z")) (SIZE(1..8)) }
U2 ::= SEQUENCE { f BOOLEAN, s IA5String (FROM("AB")) (SIZE(1..2, ...)) }
U3 ::= SEQUENCE { f BOOLEAN, s IA5String (FROM(" ".."@")) (SIZE(1..8)) }
U4 ::= SEQUENCE { f BOOLEAN, s UniversalString (FROM("a".."d")) (SIZE(1..4)) }
U5 ::= SEQUENCE { f BOOLEAN, s NumericString (SIZE(0..64)) }
U6 ::= SEQUENCE { f BOOLEAN, s IA5String (FROM("0".."9")) (SIZE(5)) }
B1 ::= SEQUENCE { f BOOLEAN, s PrintableString }
B2 ::= SEQUENCE { f BOOLEAN, s NumericString }
B3 ::= SEQUENCE { f BOOLEAN, s IA5String }
B4 ::= SEQUENCE { f BOOLEAN, s VisibleString }
B5 ::= SEQUENCE { f BOOLEAN, s BMPString }
B6 ::= SEQUENCE { f BOOLEAN, s UniversalString }
B7 ::= SEQUENCE { f BOOLEAN, s UTF8String }
B8 ::= SEQUENCE { f BOOLEAN, s PrintableString (SIZE(1..150, ...)) }
B9 ::= SEQUENCE { f BOOLEAN, s PrintableString (SIZE(1..4, ...)) }
B10 ::= SEQUENCE { f BOOLEAN, s VisibleString (SIZE(1..4, ...)) }
N ::= NumericString
N2 ::= N
N3 ::= NumericString (SIZE(1..10, ...))
V1 ::= SEQUENCE { f BOOLEAN, s N }
V2 ::= SEQUENCE { f BOOLEAN, s N2 }
V3 ::= SEQUENCE { f BOOLEAN, s N3 }
V4 ::= SEQUENCE { f BOOLEAN, s SEQUENCE OF NumericString }
V5 ::= SEQUENCE { f BOOLEAN, s CHOICE { a NumericString, b N } }
V6 ::= SEQUENCE { f BOOLEAN, s N (SIZE(2..3)) }
V7 ::= SEQUENCE { f BOOLEAN, s SET OF N }
Ap ::= PrintableString
Ap2 ::= Ap
Ai ::= IA5String
Ai2 ::= Ai
Av ::= VisibleString
Av2 ::= Av
Ab ::= BMPString
Ab2 ::= Ab
W1 ::= SEQUENCE { f BOOLEAN, s N2 }
W2 ::= SEQUENCE { f BOOLEAN, s Ap2 }
W3 ::= SEQUENCE { f BOOLEAN, s Ai2 }
W4 ::= SEQUENCE { f BOOLEAN, s Av2 }
W5 ::= SEQUENCE { f BOOLEAN, s Ab2 }
X1 ::= SEQUENCE { f BOOLEAN, s IA5String (SIZE(0..1)) }
X2 ::= SEQUENCE { f BOOLEAN, s BMPString (SIZE(0..1)) }
X3 ::= SEQUENCE { f BOOLEAN, s NumericString (SIZE(1..4)) }
X4 ::= SEQUENCE { f BOOLEAN, s IA5String (FROM("AB")) (SIZE(8..15)) }
X5 ::= SEQUENCE { f BOOLEAN, s IA5String (FROM("AB")) (SIZE(8..16)) }

END
