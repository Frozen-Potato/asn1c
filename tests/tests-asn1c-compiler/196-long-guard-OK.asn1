-- OK: Everything is fine
-- Constants outside the 32-bit range need a 64-bit long. asn1c adds a
-- guard to the C files of the types that have them (see check-long-guard.sh)
-- and none to the others.

-- iso.org.dod.internet.private.enterprise (1.3.6.1.4.1)
-- .spelio.software.asn1c.test (9363.1.5.1)
-- .196

ModuleLongGuard
	{ iso org(3) dod(6) internet (1) private(4) enterprise(1)
		spelio(9363) software(1) asn1c(5) test(1) 196 }
	DEFINITIONS AUTOMATIC TAGS ::=
BEGIN

	-- No guard: every constant fits a 32-bit long, or an unsigned long
	Narrow ::= SEQUENCE {
		signed32	INTEGER (-2147483648..2147483647),
		unsigned32	INTEGER (0..4294967295),
		dflt		INTEGER (0..100) DEFAULT 5,
		dfltu32		INTEGER (0..4294967295) DEFAULT 4294967295,
		e		ENUMERATED { a(0), b(2147483647) }
	}

	-- Guard: the bounds wrap to (1294967296..1294967306) in a 32-bit long,
	-- a range of its own, so nothing would notice
	WrapsToRange ::= INTEGER (-3000000000..-2999999990)

	Above32 ::= INTEGER (0..5000000000)
	Below32 ::= INTEGER (-4000000001..5)
	Huge ::= INTEGER (0..9223372036854775807)
	-- Beyond what a 64-bit long holds: the guard asks for 64 bits, not more
	Unsigned64 ::= INTEGER (0..18446744073709551615)
	Dflt ::= SEQUENCE { v INTEGER (0..10) DEFAULT 5, w INTEGER DEFAULT 5000000000 }
	Enum ::= ENUMERATED { a(0), b(5000000000) }
	Sz ::= OCTET STRING (SIZE(0..5000000000))

END
