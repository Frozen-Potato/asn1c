C50{X} ::= SEQUENCE { a C51{X} }
C51{X} ::= SEQUENCE { a C52{X} }
C52{X} ::= SEQUENCE { a C53{X} }
C53{X} ::= SEQUENCE { a C54{X} }
C54{X} ::= SEQUENCE { a C55{X} }
C55{X} ::= SEQUENCE { a C56{X} }
C56{X} ::= SEQUENCE { a C57{X} }
C57{X} ::= SEQUENCE { a C58{X} }
C58{X} ::= SEQUENCE { a C59{X} }
C59{X} ::= SEQUENCE { a C60{X} }
C60{X} ::= SEQUENCE { a C61{X} }
C61{X} ::= SEQUENCE { a C62{X} }
C62{X} ::= SEQUENCE { a C63{X} }
