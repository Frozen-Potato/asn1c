C10{X} ::= SEQUENCE { a C11{X} }
C11{X} ::= SEQUENCE { a C12{X} }
C12{X} ::= SEQUENCE { a C13{X} }
C13{X} ::= SEQUENCE { a C14{X} }
C14{X} ::= SEQUENCE { a C15{X} }
C15{X} ::= SEQUENCE { a C16{X} }
C16{X} ::= SEQUENCE { a C17{X} }
C17{X} ::= SEQUENCE { a C18{X} }
C18{X} ::= SEQUENCE { a C19{X} }
C19{X} ::= SEQUENCE { a C20{X} }
C20{X} ::= SEQUENCE { a C21{X} }
C21{X} ::= SEQUENCE { a C22{X} }
C22{X} ::= SEQUENCE { a C23{X} }
C23{X} ::= SEQUENCE { a C24{X} }
C24{X} ::= SEQUENCE { a C25{X} }
C25{X} ::= SEQUENCE { a C26{X} }
C26{X} ::= SEQUENCE { a C27{X} }
C27{X} ::= SEQUENCE { a C28{X} }
C28{X} ::= SEQUENCE { a C29{X} }
C29{X} ::= SEQUENCE { a C30{X} }
C30{X} ::= SEQUENCE { a C31{X} }
C31{X} ::= SEQUENCE { a C32{X} }
C32{X} ::= SEQUENCE { a C33{X} }
C33{X} ::= SEQUENCE { a C34{X} }
C34{X} ::= SEQUENCE { a C35{X} }
C35{X} ::= SEQUENCE { a C36{X} }
C36{X} ::= SEQUENCE { a C37{X} }
C37{X} ::= SEQUENCE { a C38{X} }
C38{X} ::= SEQUENCE { a C39{X} }
C39{X} ::= SEQUENCE { a C40{X} }
C40{X} ::= SEQUENCE { a C41{X} }
C41{X} ::= SEQUENCE { a C42{X} }
C42{X} ::= SEQUENCE { a C43{X} }
C43{X} ::= SEQUENCE { a C44{X} }
C44{X} ::= SEQUENCE { a C45{X} }
C45{X} ::= SEQUENCE { a C46{X} }
C46{X} ::= SEQUENCE { a C47{X} }
C47{X} ::= SEQUENCE { a C48{X} }
