-- OK: parameterized types that use themselves or each other, where the
-- specializations end: T{BOOLEAN} needs T{INTEGER}, which needs only itself;
-- R{X} uses R{X}; P1..P5 go around once and end in P1{INTEGER}. A chain of
-- 66 different parameterized types, each specialized inside the previous
-- one, is deeper than the limit on how deep the specializations of one
-- type may nest, and is accepted.

K189 DEFINITIONS AUTOMATIC TAGS ::= BEGIN
T{X} ::= SEQUENCE { a X, b T{INTEGER} OPTIONAL }
U1 ::= T{BOOLEAN}
R{X} ::= SEQUENCE { a X, b R{X} OPTIONAL }
U2 ::= R{SEQUENCE OF INTEGER}
P1{X} ::= SEQUENCE { a P2{SEQUENCE OF X} }
P2{X} ::= SEQUENCE { a P3{SEQUENCE OF X} }
P3{X} ::= SEQUENCE { a P4{SEQUENCE OF X} }
P4{X} ::= SEQUENCE { a P5{SEQUENCE OF X} }
P5{X} ::= SEQUENCE { a X, b P1{INTEGER} OPTIONAL }
U3 ::= P1{BOOLEAN}
C1{X} ::= SEQUENCE { a C2{X} }
C2{X} ::= SEQUENCE { a C3{X} }
C3{X} ::= SEQUENCE { a C4{X} }
C4{X} ::= SEQUENCE { a C5{X} }
C5{X} ::= SEQUENCE { a C6{X} }
C6{X} ::= SEQUENCE { a C7{X} }
C7{X} ::= SEQUENCE { a C8{X} }
C8{X} ::= SEQUENCE { a C9{X} }
