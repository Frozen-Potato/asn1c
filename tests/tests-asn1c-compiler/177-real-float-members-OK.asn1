-- OK: a float-narrowed REAL (X.696 12.2) as a named type, as an inline member
-- of a SEQUENCE / OPTIONAL / CHOICE and as the element of a SEQUENCE OF; the
-- members named r in different types must not clash with -fcompound-names

-- iso.org.dod.internet.private.enterprise (1.3.6.1.4.1)
-- .spelio.software.asn1c.test (9363.1.5.1)
-- .177

ModuleRealFloatMembers
	{ iso org(3) dod(6) internet(1) private(4) enterprise(1)
		spelio(9363) software(1) asn1c(5) test(1) 177 }
	DEFINITIONS AUTOMATIC TAGS ::=
BEGIN

	Fl ::= REAL (WITH COMPONENTS { mantissa (-16777215..16777215),
			base (2), exponent (-100..100) })

	N ::= SEQUENCE { a BOOLEAN, f Fl }

	M ::= SEQUENCE { a BOOLEAN,
		r REAL (WITH COMPONENTS { mantissa (-16777215..16777215),
			base (2), exponent (-100..100) }) }

	O ::= SEQUENCE { a BOOLEAN,
		r REAL (WITH COMPONENTS { mantissa (-16777215..16777215),
			base (2), exponent (-100..100) }) OPTIONAL }

	C ::= CHOICE { a BOOLEAN,
		r REAL (WITH COMPONENTS { mantissa (-16777215..16777215),
			base (2), exponent (-100..100) }) }

	L ::= SEQUENCE OF REAL (WITH COMPONENTS { mantissa (-16777215..16777215),
			base (2), exponent (-100..100) })

	LF ::= SEQUENCE OF Fl

	-- a double REAL member, whose C must be unchanged
	M2 ::= SEQUENCE { a BOOLEAN, r REAL }

