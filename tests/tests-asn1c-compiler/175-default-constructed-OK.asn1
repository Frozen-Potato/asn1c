-- OK: DEFAULT of a SEQUENCE, SET, SEQUENCE OF or SET OF member: the braces
-- value (members in order, or in any order for a SET, SEQUENCE OF lists,
-- nested values, extension additions), a whole value reference and a value
-- imported from another module; a value that cannot be converted (CHOICE, an
-- unknown member, a missing required member, a recursive default) leaves
-- the member as it was before (no default callbacks).

-- iso.org.dod.internet.private.enterprise (1.3.6.1.4.1)
-- .spelio.software.asn1c.test (9363.1.5.1)
-- .175

ModuleDefaultConstructed
	{ iso org(3) dod(6) internet(1) private(4) enterprise(1)
		spelio(9363) software(1) asn1c(5) test(1) 175 }
	DEFINITIONS AUTOMATIC TAGS ::=
BEGIN

	IMPORTS ImpPt, imp-pt FROM ModuleDefaultConstructedBase;

	Pt ::= SEQUENCE { x INTEGER (0..255), y INTEGER (0..255) DEFAULT 7 }
	Ls ::= SEQUENCE (SIZE (0..4)) OF INTEGER (0..9)
	pt0 Pt ::= { x 1, y 2 }

	T ::= SEQUENCE {
		f SEQUENCE { m INTEGER (0..9) } DEFAULT { m 5 },
		a Pt DEFAULT { x 1, y 2 },
		b Pt DEFAULT pt0,
		d Ls DEFAULT { },
		e Ls DEFAULT { 1, 2 },
		g Pt DEFAULT { x 4 },
		z BOOLEAN
	}

	Color ::= ENUMERATED { red, green, blue }

	St ::= SET {
		p INTEGER (0..9),
		q BOOLEAN,
		r IA5String (SIZE (0..8)) DEFAULT "ab"
	}

	Ext ::= SEQUENCE {
		a INTEGER (0..9),
		b INTEGER (0..9) OPTIONAL,
		...,
		c INTEGER (0..9),
		d BOOLEAN DEFAULT TRUE
	}

	Digit ::= INTEGER (0..9)

	-- Members the prototype T above does not have
	U ::= SEQUENCE {
		h St DEFAULT { r "x", q TRUE, p 3 },
		i SEQUENCE (SIZE (0..3)) OF Pt DEFAULT { { x 1 }, { x 2, y 3 } },
		j SEQUENCE (SIZE (0..3)) OF BOOLEAN DEFAULT { TRUE, FALSE },
		k SEQUENCE (SIZE (0..3)) OF Color DEFAULT { red, blue },
		l SEQUENCE {
			n SEQUENCE { v Ls, w INTEGER (0..9) }
		} DEFAULT { n { v { 3, 4 }, w 9 } },
		m Ext DEFAULT { a 1, c 2 },
		n ImpPt DEFAULT imp-pt,
		o SEQUENCE { s UTF8String, t UTF8String } DEFAULT { s "a&b", t "x<y>z" },
		p SEQUENCE { oc OCTET STRING, oi OBJECT IDENTIFIER }
			DEFAULT { oc 'DEADBEEF'H, oi { 1 3 6 1 4 } },
		q Ls DEFAULT { 1, 2, 3, 4 },
		r SEQUENCE (SIZE (0..3)) OF Digit DEFAULT { 5, 6 },
		s SEQUENCE (SIZE (0..3)) OF item INTEGER (0..9) DEFAULT { 7 },
		t SET (SIZE (0..3)) OF IA5String DEFAULT { "A", "B" },
		z BOOLEAN
	}

	-- Filling r from its own DEFAULT would never end: no default callbacks
	R ::= SEQUENCE { v INTEGER, r R DEFAULT { v 1 } }

END

ModuleDefaultConstructedBase
	{ iso org(3) dod(6) internet(1) private(4) enterprise(1)
		spelio(9363) software(1) asn1c(5) test(1) 1750 }
	DEFINITIONS AUTOMATIC TAGS ::=
BEGIN

	EXPORTS ALL;

	ImpPt ::= SEQUENCE { x INTEGER (0..255), y INTEGER (0..255) DEFAULT 7 }
	imp-pt ImpPt ::= { x 9, y 8 }

END
